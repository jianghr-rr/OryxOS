<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.oryx-labs</groupId>
  <artifactId>oryxos</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>OryxOS</name>
  <description>Java-native AI Agent Harness OS</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <spring-ai.version>1.1.8</spring-ai.version>
    <mcp.version>0.18.3</mcp.version>
    <oryxos.tests.mode>local</oryxos.tests.mode>
    <excludedGroups>real-integration,kernel-soak,kernel-short-gate,kernel-writer-probe,kernel-redactor-probe,kernel-reader-probe,kernel-provider-probe</excludedGroups>
  </properties>

  <modules>
    <module>oryxos-core</module>
    <module>oryxos-provider</module>
    <module>oryxos-memory</module>
    <module>oryxos-tool</module>
    <module>oryxos-channel-cli</module>
    <module>oryxos-web</module>
    <module>oryxos-storage</module>
    <module>oryxos-cli</module>
    <module>oryxos-boot</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-bom</artifactId>
        <version>${mcp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>4.7.7</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>3.51.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>1.5.9</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>2.9.1</version>
      </dependency>

      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-provider</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-channel-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Even modules with no tests need the engine when reactor-wide groups are selected. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-XX:+UseZGC -XX:+ZGenerational -Xms3g -Xmx3g -XX:+AlwaysPreTouch -XX:ConcGCThreads=2 -XX:-ZProactive</argLine>
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <oryxos.test.runId>${oryxos.test.runId}</oryxos.test.runId>
            <oryxos.tests.mode>${oryxos.tests.mode}</oryxos.tests.mode>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>require-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>OryxOS requires JDK 21 or newer. Set JAVA_HOME to a supported JDK.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                  <message>Use ./mvnw or Maven 3.6.3 or newer.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
