<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.oryx-labs</groupId>
  <artifactId>oryxos</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>OryxOS</name>
  <description>Java-native AI Agent Harness OS</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <modules>
    <module>oryxos-core</module>
    <module>oryxos-provider</module>
    <module>oryxos-memory</module>
    <module>oryxos-tool</module>
    <module>oryxos-channel-cli</module>
    <module>oryxos-web</module>
    <module>oryxos-storage</module>
    <module>oryxos-cli</module>
    <module>oryxos-boot</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-provider</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-channel-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oryx-labs</groupId>
        <artifactId>oryxos-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>require-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>OryxOS requires JDK 21 or newer. Set JAVA_HOME to a supported JDK.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                  <message>Use ./mvnw or Maven 3.6.3 or newer.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
