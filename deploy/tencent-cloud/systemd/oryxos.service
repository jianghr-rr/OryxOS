[Unit]
Description=OryxOS Single-Node Agent Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oryxos
Group=oryxos
WorkingDirectory=/var/lib/oryxos/workspace

Environment=ORYXOS_ROOT=/var/lib/oryxos/workspace
Environment=SERVER_PORT=8080

ExecStart=/opt/java/jdk-21/bin/java \
  -Xms256m \
  -Xmx768m \
  -XX:+ExitOnOutOfMemoryError \
  -Dfile.encoding=UTF-8 \
  -jar /opt/oryxos/current/oryxos-boot.jar \
  --root /var/lib/oryxos/workspace \
  serve

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oryxos/workspace /var/log/oryxos

StandardOutput=journal
StandardError=journal
SyslogIdentifier=oryxos

[Install]
WantedBy=multi-user.target
