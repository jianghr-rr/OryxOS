{
  "uid": "oryxos-jvm-http",
  "title": "OryxOS JVM & HTTP",
  "description": "OryxOS 单机进程的 JVM 内存、GC、线程与 HTTP 请求指标",
  "tags": ["oryxos"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "oryxos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "process_uptime_seconds{application=\"oryxos\"}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx ratio (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "oryxos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"oryxos\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"oryxos\"}[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Live threads",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "oryxos-prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "jvm_threads_live_threads{application=\"oryxos\"}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM memory used (heap / non-heap)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "oryxos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{area}} used", "expr": "sum by (area) (jvm_memory_used_bytes{application=\"oryxos\"})" },
        { "refId": "B", "legendFormat": "heap max", "expr": "sum(jvm_memory_max_bytes{application=\"oryxos\",area=\"heap\"})" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GC pauses",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "oryxos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{gc}} pause time/s", "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_sum{application=\"oryxos\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "{{gc}} pauses/s", "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_count{application=\"oryxos\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP requests per second by uri / status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "oryxos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{method}} {{uri}} {{status}}", "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"oryxos\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP latency p50 / p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "oryxos-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"oryxos\"}[$__rate_interval])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"oryxos\"}[$__rate_interval])))" },
        { "refId": "C", "legendFormat": "mean", "expr": "sum(rate(http_server_requests_seconds_sum{application=\"oryxos\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"oryxos\"}[$__rate_interval])), 1e-9)" }
      ]
    }
  ]
}
