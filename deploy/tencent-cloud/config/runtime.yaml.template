# OryxOS 生产工作区配置模板（由发布流程同步至 /var/lib/oryxos/workspace/runtime.yaml）
# 严禁在此文件写入真实密钥；敏感值统一通过 ${VAR_NAME} 引用环境变量或 0600 权限的 secrets.local.yaml。
schema_version: 1
timezone: Asia/Shanghai

providers:
  deepseek:
    protocol: openai_chat_completions
    endpoint: https://api.deepseek.com
    completions_path: /chat/completions
    api_key: '${DEEPSEEK_API_KEY}'
    connect_timeout_seconds: 5

memory:
  backend: md
  archival_context_characters: 4000

tools:
  file:
    allowed_read_paths:
      - output
      - memory
    allowed_write_paths:
      - output
  shell:
    allowed_commands: []
    allowed_script_paths: []
    timeout_seconds: 20
  http:
    allowed_targets:
      - scheme: https
        host: open.feishu.cn
        port: 443
      - scheme: https
        host: api.open-meteo.com
        port: 443
      - scheme: https
        host: geocoding-api.open-meteo.com
        port: 443
    connect_timeout_seconds: 5
    read_timeout_seconds: 20
    max_response_bytes: 65536
