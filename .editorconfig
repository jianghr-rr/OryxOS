# Matches google-java-format (enforced by Spotless); see docs/EngineeringBaseline.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
max_line_length = 100

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{mvnw,*.cmd}]
end_of_line = unset
