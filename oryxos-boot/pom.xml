<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.oryx-labs</groupId>
    <artifactId>oryxos</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>oryxos-boot</artifactId>
  <name>OryxOS boot</name>
  <description>Spring Boot assembly and executable distribution.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-tool</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-channel-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.oryx-labs</groupId>
      <artifactId>oryxos-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.oryxlabs.oryxos.boot.OryxOsApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
