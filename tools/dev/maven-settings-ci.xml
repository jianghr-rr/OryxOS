<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <!-- Selected by tools/dev/build.py only when GITHUB_ACTIONS=true. No credentials. -->
  <interactiveMode>false</interactiveMode>
  <profiles>
    <profile>
      <id>ci-maven-mirror</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>gcs-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>gcs-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
      <properties>
        <aether.transport.http.retryHandler.count>5</aether.transport.http.retryHandler.count>
        <aether.transport.http.retryHandler.interval>5000</aether.transport.http.retryHandler.interval>
        <aether.transport.http.retryHandler.intervalMax>30000</aether.transport.http.retryHandler.intervalMax>
      </properties>
    </profile>
  </profiles>
</settings>
