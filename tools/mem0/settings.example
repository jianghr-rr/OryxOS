# Copy into .oryxos-dev/mem0.env, fill privately, chmod 600. Never commit secrets.
# ORYXOS_MEM0_IMAGE comes from .oryxos-dev/mem0-build/image.env after a verified build.
ORYXOS_MEM0_IMAGE=REPLACE_IMMUTABLE_LOCAL_IMAGE_ID
MEM0_API_KEY=REPLACE_LONG_RANDOM_PRIVATE_KEY
MEM0_JWT_SECRET=REPLACE_LONG_RANDOM_PRIVATE_SECRET
MEM0_DB_PASSWORD=REPLACE_URL_SAFE_RANDOM_HEX
MEM0_MODEL_API_KEY=REPLACE_PRIVATE_SERVICE_KEY
MEM0_MODEL_BASE_URL=REPLACE_EXPLICIT_HTTPS_BASE_URL
MEM0_LLM_MODEL=REPLACE_ACCOUNT_ENABLED_EXTRACTION_MODEL
MEM0_EMBEDDING_MODEL=REPLACE_ACCOUNT_ENABLED_EMBEDDING_MODEL
